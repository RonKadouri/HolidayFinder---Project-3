# Copy this file to ".env" (same folder) and fill in your own values.
# The real .env is not in git, because it holds passwords and API keys.

ENVIRONMENT = "development"

MYSQL_HOST = "localhost"
MYSQL_USER = "root"
MYSQL_PASSWORD = "your-mysql-password"
MYSQL_DATABASE = "holiday_finder"

# Any long random text - used to sign the login tokens:
JWT_SECRET = "change-me-to-a-long-random-string"

# Must stay exactly this, because the seed users' passwords in Database/holiday_finder.sql were hashed with it:
HASH_SALT = "The-Amazing-45800-7-Students!"

# Needed for the AI Recommendation and Ask a Question pages (empty = those pages show "AI is not configured"):
OPENAI_API_KEY = ""
OPENAI_MODEL = "gpt-5-mini"
